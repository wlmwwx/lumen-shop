# ===========================================
# 本地开发
# ===========================================
DATABASE_URL="file:./dev.db"

# 默认管理员（seed 时创建；正式使用请修改）
ADMIN_EMAIL="admin@lumen.demo"
ADMIN_PASSWORD="admin123"

# 会话有效期（天）
SESSION_TTL_DAYS=30

# ===========================================
# PayPal 支付（可选）
# ===========================================
# 在 https://developer.paypal.com/dashboard/applications/sandbox 创建 Sandbox App 获取
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# 公开给浏览器的 Client ID（供 PayPal JS SDK 加载按钮）
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""
# PayPal Webhook ID（后台订单支付状态同步用；在 Developer 后台 Webhooks 页创建后获取）
PAYPAL_WEBHOOK_ID=""
# sandbox（默认，测试用）/ live（生产）
PAYPAL_ENV="sandbox"
# 汇率：默认使用实时汇率 API（open.er-api.com → frankfurter.dev，见 lib/fx.ts，
# 内存缓存 1 小时）。以下两项为可选配置：
# 实时汇率 API 全部不可用时的兜底固定汇率（默认 0.14，即 1 CNY ≈ 0.14 USD）
PAYPAL_CNY_TO_USD_RATE=0.14
# 实时汇率缓存时长（秒），默认 3600（1 小时）；免费 API 有限流，建议 ≥ 600
# FX_RATE_CACHE_TTL_SECONDS=3600
# 降级汇率（源故障时复用的旧汇率/兜底值）的缓存时长（秒），默认 300（5 分钟）；
# 窗口过期后会重试实时源，尽快恢复真实汇率
# FX_RATE_FALLBACK_TTL_SECONDS=300

# ===========================================
# Vercel 部署（生产环境）
# ===========================================
# 生产环境请使用 PostgreSQL 数据库（如 Vercel Postgres、Turso、Neon 等）
# 示例：postgres://user:password@host:5432/database
# 示例（Neon）：postgresql://user:password@ep-xxx-xxx-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# 示例（Turso）：libsql://your-database.turso.io?authToken=xxx
# DATABASE_URL="postgresql://..."

# 生产站点 URL（用于邮件中的链接）
NEXT_PUBLIC_SITE_URL="https://your-domain.vercel.app"

# ===========================================
# 开发辅助
# ===========================================
# 设置为 "development" 开启 Prisma 查询日志
# NODE_ENV="development"
