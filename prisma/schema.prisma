generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  PENDING // 待支付
  PAID // 已支付
  SHIPPED // 已发货
  COMPLETED // 已完成
  CANCELLED // 已取消
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String
  role         Role          @default(CUSTOMER)
  createdAt    DateTime      @default(now())
  sessions     Session[]
  reviews      Review[]
  wishlist     WishlistItem[]
  orders       Order[]
  notifications Notification[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  nameEn      String?
  slug        String    @unique
  description String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  products    Product[]
}

model Product {
  id             String        @id @default(cuid())
  title          String
  titleEn        String?
  slug           String        @unique
  description    String
  descriptionEn  String?
  price          Float
  compareAtPrice Float?
  currency       String        @default("CNY")
  stock          Int           @default(10)
  images         String // JSON 数组字符串
  categoryId     String?
  category       Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  featured       Boolean       @default(false)
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  variants       Variant[]
  reviews        Review[]
  wishlistItems  WishlistItem[]
  orderItems     OrderItem[]

  @@index([categoryId])
  @@index([featured])
}

model Variant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String // 颜色 / 尺寸
  nameEn    String?
  value     String
  valueEn   String?
  price     Float?
  stock     Int?
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   @default("REVIEW_INVITE")
  orderId   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, type, orderId])
  @@index([userId, read])
}

model EmailLog {
  id        String   @id @default(cuid())
  orderId   String   @unique // 一单一封，防止重复发送
  toEmail   String
  subject   String
  body      String // HTML 模板正文
  createdAt DateTime @default(now())

  @@index([toEmail])
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  userId         String?
  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName   String
  customerEmail  String
  phone          String
  address        String
  city           String
  province       String
  postalCode     String?
  shippingMethod  String
  shippingFee     Float
  subtotal        Float
  total           Float
  currency        String      @default("CNY")
  status          OrderStatus @default(PENDING)
  paymentMethod   String
  trackingNumber  String? // 发货后生成的模拟物流单号
  createdAt       DateTime    @default(now())
  items           OrderItem[]
  events          OrderEvent[]

  @@index([userId])
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String? // 备注（物流节点文案 key，如 logPickedUp）
  createdAt DateTime    @default(now())

  @@index([orderId])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  title       String
  variantInfo String?
  price       Float
  quantity    Int

  @@index([orderId])
}
